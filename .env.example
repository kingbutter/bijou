# Bijou configuration.
# Bare metal: copy to /etc/bijou.env
# Docker:     copy to .env in this directory
# No quotes, no shell expansion.

# The quickest way to fill this whole file in: start Bijou and open
#   http://your-host:8080/setup
# It walks the Plex sign-in and hands you these values to paste back here.

PLEX_HOST=192.168.1.10
PLEX_PORT=32400
PLEX_TOKEN=

# Movie library section IDs, comma separated.
# Find them at http://PLEX_HOST:32400/library/sections?X-Plex-Token=...
PLEX_SECTIONS=1

# A session counts as "the theater" when the player's IP or name contains
# one of these. Leave empty to react to any playback on the server.
PLEX_CLIENT_MATCH=

BIJOU_BIND=0.0.0.0
BIJOU_PORT=8080

# unwatched | all | recent
BIJOU_SELECTION=unwatched
BIJOU_RECENT_TAKE=40

BIJOU_ROTATE_SECONDS=30
BIJOU_SESSION_POLL=3
BIJOU_QUEUE_REFRESH=1800

BIJOU_POSTER_WIDTH=900
BIJOU_ART_CACHE_MB=96

# The /setup helper. It stores nothing and reveals nothing about an existing
# config, but set this to 0 once you're configured if you'd rather not serve it.
BIJOU_SETUP=1
